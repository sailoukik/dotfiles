## CAVA configuration - Thor God of Thunder Edition

[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 2
bar_spacing = 1

[input]
method = pipewire
source = auto

[output]
method = ncurses
style = stereo

[color]
gradient = 1
gradient_count = 8
gradient_color_1 = '#0B0E14' # Midnight Storm
gradient_color_2 = '#1E3A5F' # Deep Asgard Blue
gradient_color_3 = '#285384' # Thunder Cloud
gradient_color_4 = '#00A8FF' # Plasma Blue
gradient_color_5 = '#00E5FF' # Electric Cyan
gradient_color_6 = '#64FFDA' # Lightning Arc
gradient_color_7 = '#F4C430' # Mjolnir Flare
gradient_color_8 = '#FFD700' # Asgard Gold

[smoothing]
monstercat = 1
waves = 0
noise_reduction = 0.77
