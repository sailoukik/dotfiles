{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/thor_logo.txt",
    "color": {
      "1": "yellow",
      "2": "cyan"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ⚡ "
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "yellow",
        "at": "white",
        "host": "cyan"
      }
    },
    {
      "type": "custom",
      "format": "──────────────────────────────",
      "outputColor": "blue"
    },
    {
      "type": "os",
      "key": "󰣇 Realm",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": " Thunder Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "󰔚 Journey Time",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": " Compositor",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": " War Room",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "󰞷 Chants",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": " Might (CPU)",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "󰢮 Fury (GPU)",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "󰘚 Spirit (RAM)",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────",
      "outputColor": "blue"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
